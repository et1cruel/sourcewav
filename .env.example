# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Application
VITE_APP_NAME=UNDERGROUND CULTURE HUB
VITE_APP_URL=http://localhost:5173

# Timezone
VITE_DEFAULT_TIMEZONE=Asia/Bangkok

# Payment (Sandbox Mode until real credentials configured)
VITE_PAYMENT_MODE=sandbox
VITE_PAYMENT_PROVIDER=promptpay_sandbox
VITE_PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# ⚠️ Do NOT commit real credentials. Service role keys must never be exposed to the frontend.